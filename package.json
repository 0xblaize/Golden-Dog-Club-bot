{
  "name": "telegram-points-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply golden_dog_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply golden_dog_db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "grammy": "^1.38.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.0"
  }
}
